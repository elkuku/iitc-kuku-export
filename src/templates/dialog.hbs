<div id="{{prefix}}Container">

    <h4><a href="#" onclick="{{main}}.confirmStep('Select-Portals')">1. Select Portals</a></h4>
    <div id="{{prefix}}-Select-Portals-Container">
        <label>
            Selection Mode:
            <select onchange="{{main}}.switchMode(this.value)">
                {{#each selectOptions}}
                    <option value="{{@key}}">{{this}}</option>
                {{/each}}
            </select>
        </label>

        <button onclick="{{main}}.checkSelectAndConfirmStep('Select-Fields')" style="float: right">Confirm</button>
        <hr>
    </div>

    <h4>2. Select Fields</h4>
    <div class="hidden" id="{{prefix}}-Select-Fields-Container">
        <label>
            From preset:
            <select onchange="{{main}}.applyPreset(this.value)">
                <option value="">Select...</option>
                {{#each presets}}
                    <option>{{this}}</option>
                {{/each}}
        </select>
        </label>
        <table>
            <tr>
                <th>Data</th>
                <th>State</th>
                <th>Inventory</th>
            </tr>
            <tr>
                <td>
                    {{#each fieldOptions.data}}
                        <label>
                            <input type="checkbox" value="{{@key}}" name="chkFields"
                                {{#if_eq @key 'guid'}}
                                   onclick="return false;" checked="checked"
                                {{/if_eq}}
                            />
                            {{this}}
                            <br>
                        </label>
                    {{/each}}
                </td>
                <td>
                    {{#each fieldOptions.state}}
                        <label>
                            <input type="checkbox" value="{{@key}}" name="chkFields" />
                            {{this}}
                            <br>
                        </label>
                    {{/each}}
                </td>
                <td>
                    {{#each fieldOptions.inventory}}
                        <label>
                            <input type="checkbox" value="{{@key}}" name="chkFields" />
                            {{this}}
                            <br>
                        </label>
                    {{/each}}
                </td>
            </tr>
        </table>
        <label>Save to preset: <input id="{{prefix}}-Preset-Input"></label>
        <button onclick="{{main}}.savePreset()">Save</button>
        <button onclick="{{main}}.confirmStep('Select-Format')" style="float: right">Confirm</button>
        <hr>

    </div>

    <h4>3. Select Format</h4>
    <div class="hidden" id="{{prefix}}-Select-Format-Container">
        <label>
            Format:
            <select onchange="{{main}}.switchFormat(this.value)">
                {{#each formatOptions}}
                    <option value="{{@key}}">{{this}}</option>
                {{/each}}
            </select>
        </label>

        <button onclick="{{main}}.confirmStep('Output');{{main}}.doExport()" style="float: right">Export</button>
        <hr>

        <div id="{{prefix}}Status"></div>
    </div>

    <h4>Result</h4>
    <div class="hidden" id="{{prefix}}-Output-Container">
        <label>
            <button onclick="{{main}}.copyToClipboard('{{prefix}}Output')">Copy</button>
            <button onclick="{{main}}.saveToFile('{{prefix}}Output')">Save</button>
            <textarea id="{{prefix}}Output" cols="80" rows="20" style="width: 100%; white-space: nowrap;"></textarea>
        </label>
    </div>

    <button class="infoButton" onclick="{{main}}.showInfo()">Info</button>

</div>
